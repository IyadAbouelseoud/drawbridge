# Copy to .env. Never commit .env.
DRAWBRIDGE_ENVIRONMENT=development
DRAWBRIDGE_LOG_LEVEL=INFO

# The services connect as the unprivileged role, so row-level security applies to them.
# The owner URL is for migrations, the corpus loaders and scripts/tenant_offboard.py —
# all of which cross tenants deliberately. See docs/ARCHITECTURE.md section 16.
# The application DSN carries no password. `app_db_password` comes from .secrets.json
# and services/api/src/secrets.py injects it. Put one back inline and it wins — which is
# the escape hatch, not the default.
DRAWBRIDGE_DATABASE_URL=postgresql+asyncpg://drawbridge_app@postgres:5432/drawbridge
DRAWBRIDGE_OWNER_DATABASE_URL=postgresql+psycopg://drawbridge:drawbridge@postgres:5432/drawbridge
DRAWBRIDGE_REDIS_URL=redis://redis:6379/0


DRAWBRIDGE_S3_ENDPOINT_URL=http://minio:9000
DRAWBRIDGE_S3_ACCESS_KEY=drawbridge
DRAWBRIDGE_S3_BUCKET_DOCUMENTS=drawbridge-documents
DRAWBRIDGE_S3_BUCKET_ARCHIVE=drawbridge-archive

DRAWBRIDGE_MODEL_REASONING=claude-opus-5
DRAWBRIDGE_MODEL_EXTRACTION=claude-haiku-4-5-20251001

# --- identity ------------------------------------------------------------------------
# Every request carries a bearer token and the tenant in it is what the row-level
# policies compare against. Off is a development convenience and the API logs a warning
# at startup; a deployment with it off is indistinguishable from a working one, because
# every request succeeds. See services/api/src/auth.py.
DRAWBRIDGE_AUTH_REQUIRED=true
DRAWBRIDGE_JWT_ISSUER=drawbridge
DRAWBRIDGE_JWT_AUDIENCE=drawbridge-api

# The HS256 signing key is `jwt_secret` in .secrets.json, not here.
# Mint tokens with `make token TENANT=<uuid>` (a person) or `make token-service` (a
# registered agent; fifteen minutes, the most the verifier accepts for one).

# Set this and the secret above stops being consulted: tokens are verified as RS256
# against Authentik's key set, and nothing here can issue one.
#   docker compose --profile identity up -d
#   DRAWBRIDGE_OIDC_JWKS_URL=http://authentik-server:9000/application/o/drawbridge/jwks/
DRAWBRIDGE_OIDC_JWKS_URL=
AUTHENTIK_BOOTSTRAP_PASSWORD=drawbridge

# n8n holds `pipeline_client_secret` (in .secrets.json, bridged by `make up`) and
# exchanges it at /auth/token for a fifteen-minute access token on every run. The day-long
# `service_token` it used to carry was retired in v1.1.0; the verifier now refuses one.

# --- agent governance (v1.1.0) ---------------------------------------------------------
# Who answers for the registered agents (packages/schemas/src/drawbridge_schemas/agents.py).
# Required outside development: the API refuses to start while any is empty.
DRAWBRIDGE_OWNER_PLATFORM=
DRAWBRIDGE_OWNER_COMPLIANCE=
DRAWBRIDGE_OWNER_SECURITY=
# Above this refund (USD; SAR at the 3.75 peg) approval needs an approver who did not
# resolve the claim's exceptions. A policy number: set it from your own risk appetite.
DRAWBRIDGE_AUTO_APPROVE_CEILING_USD=100000
# `engaged` halts every mutation without consulting the database. See
# services/api/src/killswitch.py for the database-backed switch and its three scopes.
DRAWBRIDGE_KILL_SWITCH=

# --- white label ---------------------------------------------------------------------
# What the preparer notice on a CBP form says. This is a representation to a customs
# authority rather than a logo: a licensed broker preparing their own client's claim must
# not print our "is not a customs broker" disclaimer. See
# services/packager/src/branding.py, which composes the paragraph rather than substituting
# a name into ours, and refuses a licence claim that names no filer code.
DRAWBRIDGE_PREPARER_NAME=Drawbridge
DRAWBRIDGE_PREPARER_IS_LICENSED_BROKER=false
DRAWBRIDGE_PREPARER_FILER_CODE=
DRAWBRIDGE_PREPARER_CONTACT=

# --- observability -------------------------------------------------------------------
# Empty is a working stack: spans are created and dropped, and the trace id still reaches
# audit_ledger. Jaeger's UI is on http://localhost:16686.
DRAWBRIDGE_OTEL_EXPORTER_ENDPOINT=http://jaeger:4318

# N8N_ENCRYPTION_KEY and AUTHENTIK_SECRET_KEY are read from .secrets.json by
# `make up`, which exports them for compose. See the secrets block below.

# --- secrets -------------------------------------------------------------------------
# Nothing above is a credential. The nine secrets this stack needs live in .secrets.json,
# which is gitignored and generated by:
#
#   make secrets-init          # additive: fills in what is missing, rotates nothing
#   make secrets-show          # names, sources and redactions — never values
#   make secrets-check         # what a production start would refuse on
#
# Why a file rather than these variables: an environment variable is visible in
# `docker inspect`, inherited by every child process, and rendered by
# `docker compose config`. A file read once at startup is none of those things. It is not
# encrypted, and services/api/src/secrets.py says so — the value is one place to rotate
# and a seam a real manager plugs into, not secrecy on a laptop.
#
# Point the loader somewhere else with:
# DRAWBRIDGE_SECRETS_FILE=.secrets.json
#
# Since week 14 the file is one backend of three, not the only one. `file` is the default
# because the suite and `make token` must work on a laptop with nothing running; the other
# two are what a deployment uses, and naming one removes the file from the chain entirely
# — a manager that falls back to disk when it is unreachable starts the service on stale
# plaintext, which is the failure the exercise exists to remove.
#
#   DRAWBRIDGE_SECRETS_PROVIDER=file | vault | aws
#
#   vault:  VAULT_ADDR, DRAWBRIDGE_VAULT_ROLE_ID, DRAWBRIDGE_VAULT_SECRET_ID
#           (DRAWBRIDGE_VAULT_MOUNT and _PATH default to secret/drawbridge)
#           make vault-up   — dev Vault, configured and verified end to end
#   aws:    DRAWBRIDGE_AWS_SECRET_ID, DRAWBRIDGE_AWS_REGION
#           DRAWBRIDGE_AWS_ENDPOINT_URL points the same code path at LocalStack
#
# Promote a working local file into either with `make secrets-push`. There is no `pull`:
# a command that wrote production secrets onto a laptop would undo the point of having a
# manager, and it would be the most convenient command in the file.
