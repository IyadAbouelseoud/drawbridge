# Drawbridge on-premises deployment.
#
#   cp .env.onprem.example .env.onprem      # then fill in, then:
#   docker compose -f docker-compose.onprem.yml --env-file .env.onprem up -d
#
# Nothing in this file is a secret. Every credential the deployment needs comes from Vault
# (the services) or from a file under ./secrets (the three third-party images that cannot
# read Vault). A variable with `:?` behind it in the compose file has no default and the
# deployment refuses to start without it — see docker-compose.onprem.yml.

# ------------------------------------------------------------------------------- images
# The tag every Drawbridge image is deployed at. Build and push them under these names:
#   docker build -f services/api/Dockerfile     -t drawbridge/api:$DRAWBRIDGE_VERSION .
#   docker build -f mcp_servers/mcp_hts/Dockerfile -t drawbridge/mcp-hts:$DRAWBRIDGE_VERSION .
#   ...and the other four MCP servers.
# A moving tag like `latest` here would make "what is deployed" unanswerable.
DRAWBRIDGE_VERSION=0.1.0

# ------------------------------------------------------------------------------ ingress
# The hostname clients reach this deployment on. Caddy obtains a certificate for it, and
# on an internal name with no public DNS it will fall back to its own CA — see
# infra/caddy/Caddyfile, which states that decision rather than making it for you.
DRAWBRIDGE_PUBLIC_HOST=drawbridge.internal.example
DRAWBRIDGE_ACME_EMAIL=
DRAWBRIDGE_HTTP_PORT=80
DRAWBRIDGE_HTTPS_PORT=443

# ------------------------------------------------------------------------------- secrets
# An external Vault the broker already operates. The `bootstrap` profile in the compose
# file starts a dev-mode Vault instead, for an evaluation with nothing to point at; it
# keeps its storage in memory and loses every secret on restart.
VAULT_ADDR=https://vault.internal.example:8200
DRAWBRIDGE_VAULT_MOUNT=secret
DRAWBRIDGE_VAULT_PATH=drawbridge
# From `python infra/vault_bootstrap.py`. role_id is configuration and may be committed;
# secret_id is a credential, is shown once, and belongs in whatever injects this file.
DRAWBRIDGE_VAULT_ROLE_ID=
DRAWBRIDGE_VAULT_SECRET_ID=

# --- vault-agent -----------------------------------------------------------------------
# The sidecar that renders the credentials Postgres, MinIO and n8n read. ./secrets does not
# exist any more; these two are the only credential that reaches this file, because they
# are what the manager is asked *with*.
#
# A separate path and a separate AppRole from the application's above, deliberately: the
# API has no business being able to read the database owner's password or the n8n
# encryption key, and it could not before these moved into Vault. Verified — this role is
# denied both secret/drawbridge and `list` on the mount.
#
#   python infra/vault_bootstrap.py --infra    prints all three
DRAWBRIDGE_VAULT_INFRA_PATH=drawbridge-infra
DRAWBRIDGE_VAULT_AGENT_ROLE_ID=
DRAWBRIDGE_VAULT_AGENT_SECRET_ID=

# --- retention -------------------------------------------------------------------------
# How long a backup is locked for, in days. 1830 is five years, from 19 CFR 163.4 and GCC
# Art. 175. Objects are written under S3 object lock in COMPLIANCE mode, so this cannot be
# shortened after the fact by anyone including the operator — that is the guarantee, and
# the cost is that nothing prunes and storage grows for the whole period. Raising it is
# safe; lowering it does nothing to what is already written.
DRAWBRIDGE_BACKUP_RETENTION_DAYS=1830
# Must be large enough for one compressed dump of the whole database. It is a tmpfs, so a
# customs record set is not left on the host's disk after it has been stored.
DRAWBRIDGE_BACKUP_TMP_SIZE=4g
# Seconds between restore drills. 604800 is weekly. The drill restores the newest backup
# into a scratch database and re-verifies every ledger hash chain inside the restored copy,
# then drops it — so a dump that has quietly become unrestorable is found within a week
# rather than during the incident. Set it higher if the Postgres volume cannot hold a
# second copy of the database; set it to a very large number to disable, and accept that
# the backups are then unverified.
DRAWBRIDGE_BACKUP_DRILL_INTERVAL=604800

# ------------------------------------------------------------------------------ identity
# From `python infra/authentik_bootstrap.py --tenant <uuid>`, which prints all three.
# With a JWKS URL set the API verifies RS256 only and never consults a shared secret, so
# nothing inside this deployment can mint a token.
DRAWBRIDGE_OIDC_JWKS_URL=https://drawbridge.internal.example/application/o/drawbridge/jwks/
DRAWBRIDGE_JWT_ISSUER=https://drawbridge.internal.example/application/o/drawbridge/
DRAWBRIDGE_JWT_AUDIENCE=drawbridge-api

# --------------------------------------------------------------------------- white label
# What the preparer notice on every CBP form says. This is a representation to a customs
# authority, not a logo: see services/packager/src/branding.py.
#
# Set IS_LICENSED_BROKER=true only if the party named here holds a customs broker licence
# and files under a Power of Attorney. Doing so changes what the form claims about the
# preparer, and requires FILER_CODE — a deployment that claims a licence without naming it
# is refused at build time rather than printed.
DRAWBRIDGE_PREPARER_NAME=Drawbridge
DRAWBRIDGE_PREPARER_IS_LICENSED_BROKER=false
DRAWBRIDGE_PREPARER_FILER_CODE=
DRAWBRIDGE_PREPARER_CONTACT=

# ------------------------------------------------------------------------------ sizing
DRAWBRIDGE_API_WORKERS=4
DRAWBRIDGE_LOG_LEVEL=INFO
DRAWBRIDGE_TIMEZONE=UTC
DRAWBRIDGE_S3_ACCESS_KEY=drawbridge
