# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment
.env
.env.*
!.env.example
!.env.onprem.example

# Secrets. Resolved at startup by services/api/src/secrets.py and generated by
# `make secrets-init`. Never committed, and the loader refuses an unknown key so a
# typo cannot masquerade as an unset secret.
.secrets.json
.secrets.*.json

# Data - customs documents never enter git
data/
*.pdf
*.csv
!tests/golden/**/*.csv

# Tooling
.idea/
.vscode/
*.log
node_modules/

# Claude Code local overrides
.claude/settings.local.json

# Fasah probe results are recorded by a human running the probe against the live
# sandbox; the committed repo carries the script, not an empty template that would
# make `--record` refuse to write.
scripts/fasah_probe_results.json

# Generated by scripts/pilot_us.py and scripts/pilot_ksa.py. Regenerable, and the
# contents name a tenant id that only exists in whichever database was seeded.
pilot/

# secrets/ is a tombstone as of week 15: vault-agent renders these six into tmpfs and the
# host filesystem holds none of them. The rule stays so that an upgraded deployment which
# still has the old files cannot commit them on the way to deleting them.
# The README is committed so the directory exists and says that nothing belongs in it.
secrets/*
!secrets/README.md

# `.env.onprem` is already covered by `.env.*` above; it is named here only so the reason
# is written down. It carries hostnames, a Vault AppRole secret_id and the filer code the
# deployment prints on a CBP form.
