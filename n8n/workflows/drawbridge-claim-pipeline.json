{
  "name": "drawbridge-claim-pipeline",
  "meta": {
    "description": "Ingest -> extract -> classify -> match -> triage -> persist -> approve or suspend -> package. The Postgres claim state machine is authoritative; this workflow fires transitions and never holds business state (docs/ARCHITECTURE.md section 4)."
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "errorWorkflow": "drawbridge-pipeline-error"
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "drawbridge/ingest",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "ingest-webhook",
      "name": "Ingest Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1120,
        300
      ],
      "webhookId": "drawbridge-ingest"
    },
    {
      "parameters": {
        "jsCode": "// Fail fast on a malformed batch. A claim reaching the matcher without its jurisdiction\n// would be matched under whichever statute happens to be the default, which is exactly\n// the failure that looks plausible all the way to a filing.\n//\n// `claimant` is required here rather than at the packaging step because that step runs\n// twenty minutes and one analyst decision later, and discovering then that the filing\n// identity was never supplied means the run is lost, not delayed.\nconst b = $input.first().json;\nconst REQUIRED = ['tenant_id', 'jurisdiction', 'documents', 'imports', 'exports', 'claimant'];\nfor (const f of REQUIRED) {\n  if (!b[f]) throw new Error('ingest payload missing required field: ' + f);\n}\nif (!['us', 'ksa'].includes(b.jurisdiction)) {\n  throw new Error('unknown jurisdiction: ' + b.jurisdiction);\n}\nif (!b.imports.length || !b.exports.length) {\n  throw new Error('a claim needs at least one import line and one export line');\n}\nreturn [{ json: Object.assign({}, b, {\n  as_of: b.as_of || new Date().toISOString().slice(0, 10),\n}) }];"
      },
      "id": "validate-payload",
      "name": "Validate Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -940,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/documents/batch",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tenant_id: $json.tenant_id, documents: $json.documents }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.DRAWBRIDGE_SERVICE_TOKEN }}"
            }
          ]
        }
      },
      "id": "store-documents",
      "name": "Store Documents",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -760,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/extraction/run",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tenant_id: $('Validate Payload').item.json.tenant_id, documents: $json.stored.map(function (d) { return d.document_id; }) }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.DRAWBRIDGE_SERVICE_TOKEN }}"
            }
          ]
        }
      },
      "id": "extract",
      "name": "Extract",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -580,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// /extraction/run already applied the floor and said what it found. This node decides\n// what the pipeline does about it, which is a different question and belongs here rather\n// than in the API: the floor is a rule, the response to breaching it is a policy.\n//\n// A document that could not be read at all is treated as below floor, not as absent. The\n// two are indistinguishable downstream and only one of them is safe to ignore.\nconst x = $input.first().json;\nconst unreadable = (x.documents || []).filter(d => d.readable === false).length;\nconst below = (x.confidence_below_floor || 0) + unreadable;\nreturn [{ json: Object.assign({}, x, {\n  confidence_below_floor: below,\n  confidence_ok: below === 0,\n  unreadable_documents: unreadable,\n}) }];"
      },
      "id": "confidence-gate",
      "name": "Confidence Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/classification/run",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jurisdiction: $('Validate Payload').item.json.jurisdiction, lines: $('Validate Payload').item.json.imports.map(function (l) { return { line_id: l.line_id, description: l.description, declared_code: l.hts.code }; }) }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.DRAWBRIDGE_SERVICE_TOKEN }}"
            }
          ]
        }
      },
      "id": "classify",
      "name": "Classify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// A declared code the schedule does not corroborate is not an error and not an approval.\n// It is the case an analyst should see, because classification drives the duty rate and\n// the pipeline is not permitted to change a code that was actually declared.\nconst c = $input.first().json;\nconst unsupported = c.unsupported || [];\nreturn [{ json: Object.assign({}, c, {\n  classification_ok: unsupported.length === 0,\n  unsupported_count: unsupported.length,\n}) }];"
      },
      "id": "classification-gate",
      "name": "Classification Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -40,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/matching/run",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jurisdiction: $('Validate Payload').item.json.jurisdiction, imports: $('Validate Payload').item.json.imports, exports: $('Validate Payload').item.json.exports, as_of: $('Validate Payload').item.json.as_of }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.DRAWBRIDGE_SERVICE_TOKEN }}"
            }
          ]
        }
      },
      "id": "match",
      "name": "Match",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        140,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/triage/evaluate",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ match_result: $json, confidences: $('Confidence Gate').item.json.confidences, as_of: $('Validate Payload').item.json.as_of }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.DRAWBRIDGE_SERVICE_TOKEN }}"
            }
          ]
        }
      },
      "id": "triage",
      "name": "Triage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        320,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/claims/persist",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tenant_id: $('Validate Payload').item.json.tenant_id, jurisdiction: $('Validate Payload').item.json.jurisdiction, imports: $('Validate Payload').item.json.imports, exports: $('Validate Payload').item.json.exports, matches: $('Match').item.json.matches, total_refund: $('Match').item.json.total_refund, requires_review: $('Triage').item.json.requires_review }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.DRAWBRIDGE_SERVICE_TOKEN }}"
            }
          ]
        }
      },
      "id": "persist-claim",
      "name": "Persist Claim",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "operator": {
                "type": "boolean",
                "operation": "true"
              },
              "leftValue": "={{ $('Triage').item.json.requires_review }}",
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "needs-review",
      "name": "Needs Review",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/review/suspend",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tenant_id: $('Validate Payload').item.json.tenant_id, claim_id: $('Persist Claim').item.json.claim_id, workflow_run_id: $execution.id, items: $('Triage').item.json.items }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.DRAWBRIDGE_SERVICE_TOKEN }}"
            }
          ]
        }
      },
      "id": "suspend-for-analyst",
      "name": "Suspend For Analyst",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        140
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/review/draft?tenant_id={{ $('Validate Payload').item.json.tenant_id }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.DRAWBRIDGE_SERVICE_TOKEN }}"
            }
          ]
        }
      },
      "id": "draft-analyst-memos",
      "name": "Draft Analyst Memos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1060,
        140
      ]
    },
    {
      "parameters": {
        "resume": "webhook",
        "options": {}
      },
      "id": "await-resolution",
      "name": "Await Resolution",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1240,
        140
      ],
      "webhookId": "drawbridge-review-resume"
    },
    {
      "parameters": {
        "jsCode": "// An analyst may approve, correct, reject or defer. Only the first two continue; a\n// rejected claim stops here with its reason recorded rather than proceeding quietly.\n// A deferred one also stops \u2014 it is still open, and the dispatcher will bring it back.\nconst r = $input.first().json;\nconst proceed = ['approved', 'corrected'].indexOf(r.resolution) !== -1;\nreturn [{ json: Object.assign({}, r, {\n  halt: !proceed,\n  next_state: proceed ? 'approved' : 'rejected',\n}) }];"
      },
      "id": "apply-resolution",
      "name": "Apply Resolution",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1420,
        140
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "operator": {
                "type": "boolean",
                "operation": "false"
              },
              "leftValue": "={{ $json.halt }}",
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "analyst-continued",
      "name": "Analyst Continued",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1600,
        140
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/claims/transition",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ claim_id: $('Persist Claim').item.json.claim_id, to_state: 'approved', actor: 'pipeline', reason: 'pipeline run ' + $execution.id }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.DRAWBRIDGE_SERVICE_TOKEN }}"
            }
          ]
        }
      },
      "id": "approve-claim",
      "name": "Approve Claim",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1820,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/claims/transition",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ claim_id: $('Persist Claim').item.json.claim_id, to_state: 'rejected', actor: 'analyst', reason: $('Apply Resolution').item.json.resolution_note || 'analyst did not approve' }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.DRAWBRIDGE_SERVICE_TOKEN }}"
            }
          ]
        }
      },
      "id": "halt-claim",
      "name": "Halt Claim",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1820,
        -20
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/packaging/build",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ claim_id: $('Persist Claim').item.json.claim_id, claimant: $('Validate Payload').item.json.claimant, include_artifacts: false }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.DRAWBRIDGE_SERVICE_TOKEN }}"
            }
          ]
        }
      },
      "id": "build-packet",
      "name": "Build Packet",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2000,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/claims/transition",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ claim_id: $('Persist Claim').item.json.claim_id, to_state: 'packaged', actor: 'pipeline', reason: 'packet rendered by run ' + $execution.id }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.DRAWBRIDGE_SERVICE_TOKEN }}"
            }
          ]
        }
      },
      "id": "mark-packaged",
      "name": "Mark Packaged",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2180,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ claim_id: $('Persist Claim').item.json.claim_id, state: $json.state, refund: $('Persist Claim').item.json.total_refund, transmittable: $('Build Packet').item.json.transmittable, artifacts: $('Build Packet').item.json.manifest.artifacts }) }}",
        "options": {}
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        2360,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ claim_id: $('Persist Claim').item.json.claim_id, state: 'rejected', resolution: $('Apply Resolution').item.json.resolution }) }}",
        "options": {}
      },
      "id": "respond-halted",
      "name": "Respond Halted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        2000,
        -20
      ]
    }
  ],
