{
  "id": "drawbridgeError1",
  "name": "drawbridge-pipeline-error",
  "meta": {
    "description": "Error workflow for the pipeline. A crashed run leaves a blocking review row rather than a claim stranded mid-transition."
  },
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "parameters": {},
      "id": "error-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        -420,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// A crashed run must leave the claim in a state an analyst can act on, not stranded\n// mid-transition with no record of why it stopped.\n//\n// Until v1.1.0 this posted `tenant_id: e.tenant_id`. The Error Trigger's payload carries\n// the execution and the workflow and no tenant, so the key was undefined, JSON.stringify\n// dropped it, and the API refused the request: no crash ever reached the queue. It also\n// filed every crash as `solver_infeasible`. The API now attributes the run itself, from\n// the record `/pipeline/admit` wrote when the run started.\nconst e = $input.first().json;\nconst ex = e.execution || {};\nreturn [{ json: {\n  workflow_run_id: String(ex.id),\n  node: ex.lastNodeExecuted || '',\n  message: ((ex.error && ex.error.message) || 'unknown error').slice(0, 1500),\n  workflow: (e.workflow || {}).name || '',\n} }];"
      },
      "id": "build-exception",
      "name": "Build Exception",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DRAWBRIDGE_TOKEN_URL || 'http://api:8000/auth/token' }}",
        "options": {
          "response": {
            "response": {
              "neverError": false
            }
          }
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "grant_type",
              "value": "client_credentials"
            },
            {
              "name": "client_id",
              "value": "agent:n8n-pipeline"
            },
            {
              "name": "client_secret",
              "value": "={{ $env.DRAWBRIDGE_PIPELINE_CLIENT_SECRET }}"
            }
          ]
        }
      },
      "id": "get-access-token",
      "name": "Get Access Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -90,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/pipeline/failure",
        "options": {
          "response": {
            "response": {
              "neverError": false
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Build Exception').first().json) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Get Access Token').first().json.access_token }}"
            }
          ]
        }
      },
      "id": "report-failure",
      "name": "Report Failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        20,
        300
      ]
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Build Exception",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Exception": {
      "main": [
        [
          {
            "node": "Get Access Token",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Access Token": {
      "main": [
        [
          {
            "node": "Report Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
