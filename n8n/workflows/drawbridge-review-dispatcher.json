{
  "name": "drawbridge-review-dispatcher",
  "meta": {
    "description": "Polls the review queue, drafts pre-analysis for anything still undrafted, and escalates. Deadline-driven: an exception whose filing window is closing deserves more attention than an older one whose window is open. The drafting sweep is a backstop for rows queued outside a pipeline run \u2014 the error workflow queues some \u2014 and is a no-op for rows the pipeline already drafted."
  },
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "every-15-minutes",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -620,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://api:8000/review/queue?tenant_id={{ $json.tenant_id }}&state=open&limit=200",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.DRAWBRIDGE_SERVICE_TOKEN }}"
            }
          ]
        }
      },
      "id": "fetch-open-queue",
      "name": "Fetch Open Queue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -400,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/review/draft?tenant_id={{ $json.tenant_id }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.DRAWBRIDGE_SERVICE_TOKEN }}"
            }
          ]
        }
      },
      "id": "draft-missing-memos",
      "name": "Draft Missing Memos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Blocking first, then by how little time is left on the filing window. Age alone is\n// the wrong sort: a three-week-old item with six months of runway is less urgent than\n// yesterday's item with nine days.\n//\n// Reads the queue from the fetch node rather than from its own input, because the\n// drafting sweep sits between them and returns a count, not the rows.\nconst items = $('Fetch Open Queue').all().map(i => i.json);\nconst RANK = { blocking: 0, high: 1, normal: 2, low: 3 };\nitems.sort(function (a, b) {\n  const s = (RANK[a.severity] === undefined ? 9 : RANK[a.severity])\n          - (RANK[b.severity] === undefined ? 9 : RANK[b.severity]);\n  if (s !== 0) return s;\n  const da = (a.payload && a.payload.days !== undefined) ? a.payload.days : 9999;\n  const db = (b.payload && b.payload.days !== undefined) ? b.payload.days : 9999;\n  return da - db;\n});\nreturn items.map(function (json) { return { json: json }; });"
      },
      "id": "rank-by-urgency",
      "name": "Rank By Urgency",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -40,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "leftValue": "={{ $json.severity }}",
              "rightValue": "blocking"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "is-blocking",
      "name": "Is Blocking",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        160,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Blocking exceptions page immediately. Everything else waits for the digest: paging on\n// a normal-severity item trains people to ignore the pager.\nreturn [{ json: {\n  channel: 'page',\n  severity: $json.severity,\n  summary: $json.summary,\n  citation: $json.citation,\n  review_id: $json.review_id,\n} }];"
      },
      "id": "escalate",
      "name": "Escalate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        380,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: {\n  channel: 'digest',\n  count: $input.all().length,\n  items: $input.all().map(function (i) {\n    return { id: i.json.review_id, reason: i.json.reason, summary: i.json.summary };\n  }),\n} }];"
      },
      "id": "digest",
      "name": "Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        380,
        440
      ]
    }
  ],
  "connections": {
    "Every 15 Minutes": {
      "main": [
        [
          {
            "node": "Fetch Open Queue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Open Queue": {
      "main": [
        [
          {
            "node": "Draft Missing Memos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Draft Missing Memos": {
      "main": [
        [
          {
            "node": "Rank By Urgency",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Rank By Urgency": {
      "main": [
        [
          {
            "node": "Is Blocking",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Blocking": {
      "main": [
        [
          {
            "node": "Escalate",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "tags": [
    {
      "name": "drawbridge"
    },
    {
      "name": "hitl"
    }
  ]
}
